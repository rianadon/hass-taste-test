{
    // Type-checks the library together with the AVA and Jest tests (which Node and Jest run by
    // stripping types). tsconfig.build.json emits the published CommonJS output.
    "compilerOptions": {
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["es2022", "dom", "dom.iterable"],
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        // Keep source runnable by Node's built-in type stripping
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "rewriteRelativeImportExtensions": true
    },
    "include": ["src/**/*", "test/**/*.ts"]
}
