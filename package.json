{
    "name": "hass-taste-test",
    "version": "0.3.0",
    "description": "Integration testing for Home Assistant cards",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        }
    },
    "scripts": {
        "test": "npm run test:jest && ava",
        "test:jest": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
        "typecheck": "tsc",
        "build": "rimraf lib && tsc -p tsconfig.build.json",
        "prepare": "husky",
        "prepublishOnly": "npm run build"
    },
    "bin": {
        "hass-taste-test": "lib/bin.js"
    },
    "author": "rianadon",
    "homepage": "https://github.com/rianadon/hass-taste-test#readme",
    "license": "AGPL-3.0-or-later",
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "home-assistant-js-websocket": "^9.9.0",
        "proper-lockfile": "^4.1.2",
        "ws": "^8.23.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/jest-image-snapshot": "^6.4.2",
        "@types/node": "^22.0.0",
        "@types/proper-lockfile": "^4.1.4",
        "@types/ws": "^8.18.2",
        "ava": "^8.5.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-image-snapshot": "^6.5.2",
        "lint-staged": "^17.6.2",
        "playwright": "^1.65.1",
        "prettier": "^3.10.1",
        "rimraf": "^6.1.4",
        "typescript": "~5.9.3"
    },
    "prettier": {
        "printWidth": 100,
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true
    },
    "ava": {
        "files": [
            "test/**/*.ava.ts"
        ],
        "extensions": [
            "ts"
        ]
    },
    "jest": {
        "rootDir": "test",
        "testEnvironment": "node",
        "testMatch": [
            "**/*.jest.ts"
        ],
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "transform": {}
    },
    "lint-staged": {
        "*.{ts,js,json,css,md}": "prettier --write"
    }
}
