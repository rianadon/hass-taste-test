{
    // The published package is CommonJS so it loads everywhere, including Jest's default
    // CommonJS mode. The source stays ESM (see tsconfig.json); only the output format differs.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "outDir": "lib",
        "rootDir": "src",
        "module": "commonjs",
        "moduleResolution": "bundler",
        // home-assistant-js-websocket's "require" export has no types; resolve via "types" like node10 did
        "resolvePackageJsonExports": false,
        "verbatimModuleSyntax": false,
        "esModuleInterop": true
    },
    "include": ["src/**/*"]
}
